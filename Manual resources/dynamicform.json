    "label": "Reset password",
    "fields": [
      {
        "key": "blnreset",
        "templateOptions": {
          "label": "Reset password",
          "useSwitch": true,
          "checkboxLabel": " "
        },
        "type": "boolean",
        "defaultValue": true,
        "summaryVisibility": "Show",
